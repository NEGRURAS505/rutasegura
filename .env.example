# RutaSegura Carmen — variables de entorno (copiar a .env; NUNCA subir el .env real)

# IA: Gemma a través de la Gemini API
GEMINI_API_KEY=
# Nombre del modelo Gemma disponible en la Gemini API (los prompts y la
# integración no tienen el modelo fijo en el código). Alternativa rápida:
# gemma-4-26b-a4b-it (más velocidad, MoE).
GEMMA_MODEL=gemma-4-31b-it

# Bot de Telegram que recibe las alertas de pánico (simula a la policía)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# true = el backend responde con datos de ejemplo (3 unidades ficticias
# moviéndose) sin depender del backend real; útil para roles 2/3/5 en Fase A
MOCK_MODE=true

# Base de datos (SQLite). En docker-compose se fuerza sqlite:////data/rutasegura.db
# DATABASE_URL=sqlite:///./data/rutasegura.db
