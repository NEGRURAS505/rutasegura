{
  "name": "rutasegura-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Amor X Carmen Movi App: aplicación piloto para pasajero y conductor en Ciudad del Carmen",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "sync:android": "cap sync android",
    "apk:debug": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.2.26",
    "@capacitor/android": "7.6.9",
    "@capacitor/barcode-scanner": "2.1.0",
    "@capacitor/core": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "maplibre-gl": "6.14.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
